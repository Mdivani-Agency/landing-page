# GA4 / Firebase Analytics measurement ID (G-XXXXXXXX).
# Either name works. Leave unset for local development without tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Contact form (server-only — never prefix these with NEXT_PUBLIC_).
# Used by POST /api/contact to send inquiries through Resend.
# CONTACT_FROM_EMAIL must be an address on a Resend-verified domain
# (mdivani.agency) or Resend rejects the send.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@mdivani.agency
CONTACT_TO_EMAIL=giorgi@mdivani.agency

# Rate limiting for POST /api/contact via Upstash Redis REST (e.g. the Vercel
# Upstash integration). Required in production; without them the route falls
# back to a best-effort in-memory limit that does not hold across serverless
# isolates.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
