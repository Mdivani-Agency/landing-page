# GA4 / Firebase Analytics measurement ID (G-XXXXXXXX).
# Either name works. Leave unset for local development without tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Contact form (server-only — never prefix these with NEXT_PUBLIC_).
# Used by POST /api/contact to send inquiries through Resend.
# CONTACT_FROM_EMAIL must be an address on a Resend-verified domain
# (sales.mdivani.agency) or Resend rejects the send.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@sales.mdivani.agency
CONTACT_TO_EMAIL=giorgi@mdivani.agency

# Supabase (server-only — never prefix these with NEXT_PUBLIC_).
# Reads use the publishable key and stay subject to row level security. The
# secret key bypasses row level security, so it is only for server-side
# writes. Both live under Settings > API Keys in the Supabase dashboard.
SUPABASE_URL=https://fokgusrsmrhatfrdcasg.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Rate limiting for POST /api/contact via Upstash Redis REST.
# The Vercel Upstash / KV integration writes KV_REST_API_URL and
# KV_REST_API_TOKEN — those names work too. Required in production; without
# a REST URL+token pair the route falls back to a best-effort in-memory
# limit that does not hold across serverless isolates.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Sentry. The DSN is safe to expose in the browser (NEXT_PUBLIC_).
# SENTRY_AUTH_TOKEN is a build-only secret for source map upload — never
# prefix it with NEXT_PUBLIC_ and never commit it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
