{
  "name": "mdio-landing-page",
  "version": "1.0.0",
  "description": "Get info about mdio and contact us",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:eleventy": "eleventy --serve",
    "build:eleventy": "postcss src/css/base.css -o src/styles.css && eleventy",
    "tw": "npx tailwindcss -i src/css/base.css -o src/styles.css --watch",
    "deploy": "yarn build:eleventy && npx firebase deploy"
  },
  "keywords": [
    "mdio",
    "landing",
    "page",
    "homepage"
  ],
  "author": "Giorgi Mdivani",
  "license": "ISC",
  "packageManager": "yarn@4.9.2",
  "devDependencies": {
    "@11ty/eleventy": "3.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "firebase-tools": "^13.29.2",
    "postcss": "8.5.1",
    "postcss-cli": "11.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
